// ; dedicated garbage register = r7

A0400000 //       0x00 lda r4, 6
21100001 // STRT: 0x01 lri r1, 1
A8210000 // NEXT: 0x02 ldx r2, r1, 0
A8310001 //       0x03 ldx r3, r1, 1
12732000 //       0x04 sub r7, r3, r2  ; set neg bit if r2 > r3
62000008 //       0x05 bne A, 0010     ; skip swap if neg r3 > r2
B8310000 //       0x06 stx r3, r1, 0
B8210001 //       0x07 stx r2, r1, 1
21110001 //    A: 0x08 inc r1
12741000 //       0x09 sub r7, r4,r1   ; set zero bit if at end of list
61000002 //       0x0A bne NEXT, 0001  ; go to next compare if not at end 0B dec r4
2144FFFF //       0x0B dec r4
22740001 //       0x0C sbi r7, r4, 1   ; compare r4 and r1
4100000F //       0x0D bra END, 0001   ; end if r4 == 0
60000001 //       0x0E jmp STRT        ; start at beggining of list if not at end
F0000000 //  END: 0x0F hlt
